@@ -0,0 +1,104 @@
+; FakeSolar: Faketec (ProMicro nRF52840) + E22-400M22S (SX1268) + AHT20/BMP280/BME280 + INA3221 + PCF8563 + GPS
+; Based on fdlamotte/gps_refactor (GPS refactor with GPS_GUARD and the baud probe list).
+; Board sources are shared with variants/promicro.
+; SX126X_REGISTER_PATCH sets the undocumented 0x8B5 RX/AGC register bit (Semtech/Heltec advice;
+; Meshtastic sets it on every SX126x). Re-applied after each AGC reset (calibration clears it).
+
+[Faketec_SX1268]
+extends = Promicro
+build_flags = ${nrf52_base.build_flags}
+  -I variants/promicro
+  -D PROMICRO
+  -D USE_SX1268
+  -D RADIO_CLASS=CustomSX1268
+  -D WRAPPER_CLASS=CustomSX1268Wrapper
+  -D LORA_TX_POWER=22
+  -D SX126X_CURRENT_LIMIT=140
+  -D SX126X_RX_BOOSTED_GAIN=1
+  -D SX126X_REGISTER_PATCH=1
+  -D LORA_FREQ=433.650
+  -D LORA_BW=62.5
+  -D LORA_SF=8
+  -D LORA_CR=8
+  -D PIN_BOARD_SCL=7
+  -D PIN_BOARD_SDA=8
+  -D PIN_OLED_RESET=-1
+  -D PIN_USER_BTN=6
+  -D PIN_GPS_RX=3
+  -D PIN_GPS_TX=4
+  -D PIN_GPS_EN=5
+  -D GPS_BAUD_PROBE_LIST=9600,115200,38400
+  -D GPS_PERIOD_DEFAULT=1800
+  -D GPS_GUARD
+  -D GPS_GUARD_LAT_MIN=44.0
+  -D GPS_GUARD_LAT_MAX=52.5
+  -D GPS_GUARD_LON_MIN=22.0
+  -D GPS_GUARD_LON_MAX=40.3
